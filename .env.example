# ============================================================
# SMRITIX Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://smritix:smritix@localhost:5432/smritix

# --- Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=smritix_chunks

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- AI Providers ---
OLLAMA_BASE_URL=http://localhost:11434

# --- JWT Authentication ---
# REQUIRED: Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
SINGLE_USER_MODE=true

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
